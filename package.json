{
  "name": "oaktree-sapling",
  "version": "0.0.0-dev",
  "description": "White-label journal engine: MyST + GitHub + Zenodo. All platform logic, referenced by version.",
  "type": "module",
  "bin": {
    "oak": "dist/cli.cjs"
  },
  "scripts": {
    "test": "npm run bundle && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=dist/cli.cjs",
    "build:fixture": "node scripts/build-fixture.mjs"
  },
  "dependencies": {
    "@curvenote/check-definitions": "^0.16.5",
    "@curvenote/check-implementations": "^0.16.5",
    "adm-zip": "^0.5.18",
    "myst-cli": "^1.10.1",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
